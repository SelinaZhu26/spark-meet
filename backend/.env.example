# Supabase Postgres (use the Session pooler connection string, port 5432;
# the transaction pooler breaks prepared statements).
DATABASE_URL=postgres://spark:spark@localhost:5544/spark
# Tiger Data service for location pings. Defaults to DATABASE_URL.
# PINGS_DATABASE_URL=postgres://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require

BIND_ADDR=0.0.0.0:8080
# Public URL of this server; OAuth callbacks are built from it.
PUBLIC_BASE_URL=http://localhost:8080

SUPABASE_URL=https://<project-ref>.supabase.co
# Only for projects still on the legacy HS256 JWT secret. Leave unset to
# verify tokens against the project's JWKS.
# SUPABASE_JWT_SECRET=

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: Spark buzz sound + spoken icebreakers.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Optional: linked accounts. Register <PUBLIC_BASE_URL>/integrations/<provider>/callback
# as the redirect URI with each provider.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=

# Deep link prefixes the app may be sent back to after OAuth.
# APP_REDIRECT_ALLOWLIST=spark://,exp://

# AUDIO_CACHE_DIR=./cache
# PROXIMITY_RADIUS_M=30
# PING_WINDOW_SECS=120
# SIMILARITY_FLOOR=0.5
# SPARK_THRESHOLD=70

RUST_LOG=spark_backend=debug,tower_http=info
